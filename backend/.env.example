# ==============================================================================
# Django Core Configuration
# ==============================================================================
SECRET_KEY=replace-with-a-long-random-production-secret-key
DEBUG=False
ALLOWED_HOSTS=your-render-service.onrender.com,localhost,127.0.0.1

# ==============================================================================
# TiDB Cloud (MySQL-Compatible) Database Configuration
# ==============================================================================
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=your_database_name
DB_USER=your_tidb_cloud_username
DB_PASSWORD=your_tidb_cloud_password

# Path to CA certificate file (relative to backend/ or absolute path)
DB_SSL_CA=certs/isrgrootx1.pem

# ==============================================================================
# CORS & CSRF Configuration (Comma-separated deployed frontend URLs)
# ==============================================================================
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-render-service.onrender.com,https://your-frontend-domain.vercel.app
